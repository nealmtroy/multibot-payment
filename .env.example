# ==============================================================================
# MULTIBOT PAYMENT - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# 💡 CATATAN PENTING:
# Token bot-bot payment untuk pembeli/member TIDAK PERLU dimasukkan di file ini!
# Setiap bot payment didaftarkan secara dinamis melalui Master Management Bot:
# Buka DM Management Bot -> Menu [🤖 Kelola Bot Payment] -> [➕ Tambah Bot Baru].
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TELEGRAM API CREDENTIALS (my.telegram.org)
# ------------------------------------------------------------------------------
# Dapatkan API ID dan API HASH dari https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# ------------------------------------------------------------------------------
# 2. MASTER MANAGEMENT BOT TOKEN (@BotFather)
# ------------------------------------------------------------------------------
# Token bot ini KHUSUS untuk Master Management Bot (Pusat Kendali Administrator).
# Bot ini TIDAK melayani pembayaran member, melainkan khusus digunakan oleh
# Administrator untuk mengontrol bot payment, paket VIP, broadcast, & withdrawal.
TELEGRAM_BOT_TOKEN=1234567890:ABCDefghIJKLmnOPQRstuvWXYZ_TokenAdminBot

# User ID Telegram Admin yang berhak mengakses & mengontrol Management Bot.
# Bisa lebih dari satu ID (pisahkan dengan tanda koma jika ada beberapa admin).
# Contoh: 123456789,987654321
ADMIN_USER_IDS=123456789

# ------------------------------------------------------------------------------
# 3. CHANNEL / GROUP LOG ADMIN
# ------------------------------------------------------------------------------
# ID Chat Group atau Channel khusus log aktivitas sistem (notifikasi pembayaran QRIS,
# pengajuan penarikan komisi referral, notifikasi bot baru aktif, dan log error).
# Format untuk supergroup/channel diawali -100 (contoh: -1001234567890).
LOG_CHAT_ID=-1001234567890

# (Opsional) Fallback default VIP Chat ID jika ada bot yang belum di-setting paketnya
VIP_CHAT_ID=

# ------------------------------------------------------------------------------
# 4. NATIVE POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# URL koneksi langsung ke PostgreSQL (asyncpg connection pool).
# Skema tabel (schema.sql) akan otomatis dibuat saat bot pertama kali dijalankan.
# Format: postgresql://[user]:[password]@[host]:[port]/[database_name]
DATABASE_URL=postgresql://postgres:password_kamu@localhost:5432/multibot_db

# ------------------------------------------------------------------------------
# 5. SOCIABUZZ PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Username akun SociaBuzz yang digunakan untuk membuat invoice & QRIS donasi.
SOCIABUZZ_USERNAME=akun_sociabuzz_kamu

# Cookie session SociaBuzz (Opsional, gunakan jika terkena Cloudflare challenge)
SOCIABUZZ_COOKIE=

# Nominal harga fallback default (hanya dipakai jika bot belum punya paket di database)
PAYMENT_AMOUNT=50000

# ------------------------------------------------------------------------------
# 6. PENGATURAN TIKET INVITE & POLLING TRANSAKSI
# ------------------------------------------------------------------------------
# Masa aktif invite link single-use VIP setelah user membayar (dalam jam)
INVITE_EXPIRE_HOURS=24

# Interval pengecekan status transaksi ke SociaBuzz (dalam detik)
POLL_INTERVAL_SECONDS=3

# Maksimal percobaan polling pembayaran sebelum invoice expired (300 x 3s = 15 menit)
POLL_MAX_ATTEMPTS=300

# Jumlah batch pemrosesan antrean pembayaran
POLL_BATCH_SIZE=20

# Batas concurrency pembuatan QRIS paralel
QRIS_CREATE_CONCURRENCY=5

# Batas batch pengiriman broadcast per detik
BROADCAST_BATCH_SIZE=20

# Level log aplikasi (INFO / DEBUG / WARNING / ERROR)
LOG_LEVEL=INFO
