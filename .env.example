TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_api_hash

# Master Management Bot Token (Khusus Administrator - tidak melayani pembayaran member)
TELEGRAM_BOT_TOKEN=123456:replace_with_management_bot_token

# Channel / Group Log Admin
LOG_CHAT_ID=-1001234567890
VIP_CHAT_ID=

# Native PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:password@localhost:5432/multibot_db

# SociaBuzz Gateway
SOCIABUZZ_USERNAME=replace_with_sociabuzz_username
SOCIABUZZ_COOKIE=
PAYMENT_AMOUNT=50000

INVITE_EXPIRE_HOURS=24
POLL_INTERVAL_SECONDS=3
POLL_MAX_ATTEMPTS=300
POLL_BATCH_SIZE=20
BROADCAST_BATCH_SIZE=20
QRIS_CREATE_CONCURRENCY=5

# User ID Telegram Admin yang berhak mengakses Management Bot (pisahkan dengan koma jika banyak)
ADMIN_USER_IDS=123456789
LOG_LEVEL=INFO
